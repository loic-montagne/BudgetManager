@using BudgetManager.Application.Features.Budget.GetById
@using BudgetManager.Domain.Enums
@using BudgetManager.Web.Controllers
@using BudgetManager.Web.Extensions
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@model BudgetDto

@{
    ViewData["Title"] = Model.Name;
}

@section styles
{
    <link href="@Url.Content("~/css/budget.css")" rel="stylesheet" type="text/css" asp-append-version="true" />
}

@section scripts
{
    <script src="@Url.Content("~/js/budget-actions.js")" type="text/javascript" asp-append-version="true"></script>
}

@section title_indicators
{
    @if (Model.IsLocked)
    {
        <i class="fa-solid fa-lock"></i>
    }
}

@section right_actions
{
    <div class="budget-actions"
         data-budget-actions
         data-budget-id="@Model.Id"
         data-budget-action-error="@SharedLocalizer["Error.Generic"]"
         data-delete-url="@Url.Action(nameof(BudgetController.Delete), nameof(BudgetController).ToControllerName())"
         data-rename-url="@Url.Action(nameof(BudgetController.Update), nameof(BudgetController).ToControllerName())"
         data-lock-url="@Url.Action(nameof(BudgetController.Lock), nameof(BudgetController).ToControllerName())"
         data-unlock-url="@Url.Action(nameof(BudgetController.Unlock), nameof(BudgetController).ToControllerName())">

        @if (Model.CurrentUserPermissions.Contains(Permission.Edit) && !Model.IsLocked)
        {
            <div class="budget-action" data-action-priority="6">
                <button type="button" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span class="budget-action-label">@Localizer["Action.AddCategory"]</span>
                </button>
            </div>
        }

        @if (Model.CurrentUserPermissions.Contains(Permission.Lock))
        {
            <div class="budget-action" data-action-priority="5">
                @if (Model.IsLocked)
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-budget-action="unlock"
                            data-budget-action-confirm
                            data-budget-action-confirm-title="@Localizer["Modal.Unlock.Title"].Value"
                            data-budget-action-confirmation="@Localizer["Modal.Unlock.Confirmation"].Value">
                        <i class="fa-solid fa-lock-open"></i>
                        <span class="budget-action-label">@Localizer["Action.Unlock"]</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-budget-action="lock"
                            data-budget-action-confirm
                            data-budget-action-confirm-title="@Localizer["Modal.Lock.Title"].Value"
                            data-budget-action-confirmation="@Localizer["Modal.Lock.Confirmation"].Value">
                        <i class="fa-solid fa-lock"></i>
                        <span class="budget-action-label">@Localizer["Action.Lock"]</span>
                    </button>
                }
            </div>
        }

        @if (Model.CurrentUserPermissions.Contains(Permission.Share))
        {
            <div class="budget-action" data-action-priority="4">
                <button type="button" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-users"></i>
                    <span class="budget-action-label">@Localizer["Action.Share"]</span>
                </button>
            </div>
        }

        @if (Model.CurrentUserPermissions.Contains(Permission.Edit) && !Model.IsLocked)
        {
            <div class="budget-action" data-action-priority="3">
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-budget-action="rename"
                        data-budget-action-form
                        data-budget-action-form-get-url="@Url.Action(nameof(BudgetController.GetEditPartial), nameof(BudgetController).ToControllerName())"
                        data-budget-action-form-post-url="@Url.Action(nameof(BudgetController.Update), nameof(BudgetController).ToControllerName())"
                        data-budget-action-form-title="@Localizer["Modal.Rename.Title"].Value">
                    <i class="fa-solid fa-pen"></i>
                    <span class="budget-action-label">@Localizer["Action.Rename"]</span>
                </button>
            </div>
        }

        <div class="budget-action" data-action-priority="2">
            <button type="button" class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-circle-info"></i>
                <span class="budget-action-label">@Localizer["Action.Details"]</span>
            </button>
        </div>

        @if (Model.IsCurrentUserOwner)
        {
            <div class="budget-action" data-action-priority="1">
                <button type="button"
                        class="btn btn-danger btn-sm"
                        data-budget-action="delete"
                        data-budget-action-confirm
                        data-budget-action-confirm-title="@Localizer["Modal.Delete.Title"].Value"
                        data-budget-action-confirmation="@Localizer["Modal.Delete.Confirmation"].Value"
                        data-budget-action-success-url="@Url.Action(nameof(HomeController.Index), nameof(HomeController).ToControllerName())">
                    <i class="fa-solid fa-trash"></i>
                    <span class="budget-action-label">@SharedLocalizer["Action.Delete"]</span>
                </button>
            </div>
        }

        <div class="budget-actions-overflow dropdown" data-budget-actions-overflow hidden>
            <button type="button"
                    class="btn btn-outline-primary btn-sm dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="@Localizer["Action.More"]">
                <i class="fa-solid fa-ellipsis-vertical"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end"
                data-budget-actions-menu>
            </ul>
        </div>
    </div>
}

<!-- Section des div modales -->
<div class="modal fade js-budget-action-confirm-modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header primary">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger js-budget-action-confirm">
                    @SharedLocalizer["Action.Yes"].Value
                </button>
                <button type="button" class="btn btn-secondary js-budget-action-confirm-cancel">
                    @SharedLocalizer["Action.No"].Value
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade js-budget-action-form-modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header primary">
                <h5 class="modal-title"></h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form class="js-budget-action-form">
                    <div class="js-budget-action-form-content"></div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary js-budget-action-form-submit">
                    @SharedLocalizer["Action.Save"].Value
                </button>
                <button type="button"
                        class="btn btn-secondary js-budget-action-form-cancel">
                    @SharedLocalizer["Action.Cancel"].Value
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Fin de la section des div modales -->