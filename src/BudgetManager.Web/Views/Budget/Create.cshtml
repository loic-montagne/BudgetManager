@using BudgetManager.Web.Models.Budget
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@model BudgetFormModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<section class="manage-content-card manage-content-card-compact">
    <h3>@ViewData["Title"]</h3>

    <form method="post" class="manage-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <partial name="_BudgetPartial" model="Model" />

        <div class="manage-form-actions">
            <button type="submit" class="btn btn-primary">
                @SharedLocalizer["Action.Add"]
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}