@page
@model ResetPasswordModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["IdentityTitle"] = Localizer["Title"].Value;
    ViewData["IdentitySubtitle"] = Localizer["Subtitle"].Value;
    Layout = "/Areas/Identity/Pages/Shared/_AnonymousIdentityLayout.cshtml";
}

<form method="post">
    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert">
    </div>

    <input asp-for="Input.Code"
           type="hidden" />

    <div class="form-floating mb-3">
        <input asp-for="Input.Email"
               class="form-control"
               autocomplete="username"
               aria-required="true"
               placeholder="name@example.com" />

        <label asp-for="Input.Email"
               class="form-label">
            @SharedLocalizer["Field.Email"]
        </label>

        <span asp-validation-for="Input.Email"
              class="text-danger">
        </span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Password"
               class="form-control"
               autocomplete="new-password"
               aria-required="true"
               data-password-requirements
               placeholder="password" />

        <label asp-for="Input.Password"
               class="form-label">
            @SharedLocalizer["Field.Password"]
        </label>

        <span asp-validation-for="Input.Password"
              class="text-danger">
        </span>
    </div>

    <partial name="_PasswordRequirements" />

    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmPassword"
               class="form-control"
               autocomplete="new-password"
               aria-required="true"
               placeholder="password" />

        <label asp-for="Input.ConfirmPassword"
               class="form-label">
            @SharedLocalizer["Field.ConfirmPassword"]
        </label>

        <span asp-validation-for="Input.ConfirmPassword"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="w-100 btn btn-lg btn-primary">
        @Localizer["Action.ResetPassword"]
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
