@page
@model LoginModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["IdentityTitle"] = Localizer["Title"].Value;
    ViewData["IdentitySubtitle"] = Localizer["Subtitle"].Value;
    Layout = "/Areas/Identity/Pages/Shared/_AnonymousIdentityLayout.cshtml";
}

<form id="account"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert">
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email"
               class="form-control"
               autocomplete="username"
               aria-required="true"
               placeholder="name@example.com" />

        <label asp-for="Input.Email"
               class="form-label">
            @SharedLocalizer["Field.Email"]
        </label>

        <span asp-validation-for="Input.Email"
              class="text-danger">
        </span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Password"
               class="form-control"
               autocomplete="current-password"
               aria-required="true"
               placeholder="password" />

        <label asp-for="Input.Password"
               class="form-label">
            @SharedLocalizer["Field.Password"]
        </label>

        <span asp-validation-for="Input.Password"
              class="text-danger">
        </span>
    </div>

    <div class="anonymous-remember mb-3">
        <input class="form-check-input"
               asp-for="Input.RememberMe" />

        <label class="form-check-label"
               asp-for="Input.RememberMe">
            @SharedLocalizer["Field.RememberMe"]
        </label>
    </div>

    <button id="login-submit"
            type="submit"
            class="w-100 btn btn-primary">
        @Localizer["Action.Login"]
    </button>

    <div class="anonymous-links">
        <a asp-page="./ForgotPassword">
            @Localizer["Link.ForgotPassword"]
        </a>

        <a asp-page="./ResendEmailConfirmation">
            @Localizer["Link.ResendConfirmation"]
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
