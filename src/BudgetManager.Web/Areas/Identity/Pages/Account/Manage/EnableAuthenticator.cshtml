@page
@model EnableAuthenticatorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<p class="manage-intro">@Localizer["Intro"]</p>

<ol class="manage-steps">
    <li>
        <p>
            @Localizer["Step1.BeforeAndroid"]<a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a>@Localizer["Step1.BetweenPlatforms"]<a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>@Localizer["Step1.BeforeGoogle"]<a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a>@Localizer["Step1.BetweenPlatforms"]<a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>@Localizer["Step1.End"]
        </p>
    </li>
    <li>
        <p>@Localizer["Step2.BeforeKey"]<kbd>@Model.SharedKey</kbd>@Localizer["Step2.AfterKey"]</p>
        <div id="qrCode"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
    </li>
    <li>
        <p>@Localizer["Step3"]</p>
        <form id="send-code" method="post" class="manage-form manage-form-compact">
            <div class="form-floating">
                <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="@Localizer["Placeholder.Code"]" />
                <label asp-for="Input.Code" class="form-label"></label>
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="manage-form-actions">
                <button type="submit" class="btn btn-primary">@Localizer["Action.Verify"]</button>
            </div>
        </form>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script>
        (() => {
            const qrCodeElement = document.getElementById("qrCode");
            const qrCodeDataElement = document.getElementById("qrCodeData");
            const authenticatorUri = qrCodeDataElement?.dataset.url;

            if (!qrCodeElement || !authenticatorUri || typeof QRCode === "undefined") {
                return;
            }

            new QRCode(qrCodeElement, {
                text: authenticatorUri,
                width: 180,
                height: 180
            });
        })();
    </script>
}
