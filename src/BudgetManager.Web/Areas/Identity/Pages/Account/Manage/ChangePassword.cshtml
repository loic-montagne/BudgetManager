@page
@model ChangePasswordModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="manage-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="form-floating">
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@Localizer["Placeholder.CurrentPassword"]" />
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>

    <div class="form-floating">
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" data-password-requirements placeholder="@Localizer["Placeholder.NewPassword"]" />
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <partial name="_PasswordRequirements" />

    <div class="form-floating">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Placeholder.ConfirmPassword"]" />
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="manage-form-actions">
        <button type="submit" class="btn btn-primary">@Localizer["Action.UpdatePassword"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
