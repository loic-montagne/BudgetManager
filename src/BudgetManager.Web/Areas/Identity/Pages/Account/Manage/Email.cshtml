@page
@model EmailModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="manage-form">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>


    <div class="input-group w-100">
        <div class="form-floating">
            <input asp-for="Email" class="form-control" placeholder="@Localizer["Placeholder.Email"]" disabled />
            <label asp-for="Email" class="form-label"></label>
        </div>
        <span class="input-group-text manage-email-confirmed" aria-hidden="true">
            <i class="fa-solid fa-check"></i>
        </span>
    </div>

    <div class="form-floating">
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="@Localizer["Placeholder.NewEmail"]" />
        <label asp-for="Input.NewEmail" class="form-label"></label>
        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
    </div>

    <div class="manage-form-actions">
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">
            @Localizer["Action.ChangeEmail"]
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
