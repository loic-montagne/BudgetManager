@page
@model ResendEmailConfirmationModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["IdentityTitle"] = Localizer["Title"].Value;
    ViewData["IdentitySubtitle"] = Localizer["Subtitle"].Value;
    Layout = "/Areas/Identity/Pages/Shared/_AnonymousIdentityLayout.cshtml";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="text-success mb-3" role="status">
        @Model.StatusMessage
    </div>
}

<form method="post">
    <div asp-validation-summary="All"
         class="text-danger"
         role="alert">
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email"
               class="form-control"
               aria-required="true"
               placeholder="name@example.com" />

        <label asp-for="Input.Email"
               class="form-label">
            @SharedLocalizer["Field.Email"]
        </label>

        <span asp-validation-for="Input.Email"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="w-100 btn btn-lg btn-primary">
        @Localizer["Action.Resend"]
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
