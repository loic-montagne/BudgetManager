@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject IOptions<IdentityOptions> IdentityOptions
@inject Microsoft.Extensions.Localization.IStringLocalizer<BudgetManager.Web.SharedResource> SharedLocalizer

@{
    var options = IdentityOptions.Value.Password;
}

<div class="password-requirements"
     data-required-length="@options.RequiredLength"
     data-required-unique-chars="@options.RequiredUniqueChars">

    <div class="password-requirements-title">
        @SharedLocalizer["PasswordRequirements.Title"]
    </div>

    <ul>
        <li data-password-rule="length">
            <i class="fa-regular fa-circle" aria-hidden="true"></i>
            <span>
                @SharedLocalizer["PasswordRequirements.Length", options.RequiredLength]
            </span>
        </li>

        @if (options.RequireUppercase)
        {
            <li data-password-rule="uppercase">
                <i class="fa-regular fa-circle" aria-hidden="true"></i>
                <span>@SharedLocalizer["PasswordRequirements.Uppercase"]</span>
            </li>
        }

        @if (options.RequireLowercase)
        {
            <li data-password-rule="lowercase">
                <i class="fa-regular fa-circle" aria-hidden="true"></i>
                <span>@SharedLocalizer["PasswordRequirements.Lowercase"]</span>
            </li>
        }

        @if (options.RequireDigit)
        {
            <li data-password-rule="digit">
                <i class="fa-regular fa-circle" aria-hidden="true"></i>
                <span>@SharedLocalizer["PasswordRequirements.Digit"]</span>
            </li>
        }

        @if (options.RequireNonAlphanumeric)
        {
            <li data-password-rule="non-alphanumeric">
                <i class="fa-regular fa-circle" aria-hidden="true"></i>
                <span>@SharedLocalizer["PasswordRequirements.NonAlphanumeric"]</span>
            </li>
        }

        @if (options.RequiredUniqueChars > 1)
        {
            <li data-password-rule="unique">
                <i class="fa-regular fa-circle" aria-hidden="true"></i>
                <span>
                    @SharedLocalizer["PasswordRequirements.UniqueChars", options.RequiredUniqueChars]
                </span>
            </li>
        }
    </ul>
</div>